# MarketAI API (FastAPI domain service) — environment variable contract.
#
# Private service, not browser-addressable. Receives delegated identity
# tokens from Web's BFF over Railway private networking.
#
# Syntax:  REQUIRED | OPTIONAL | DENIED  VARIABLE_NAME  # rationale

# ── domain database ──────────────────────────────────────────────────
REQUIRED  MARKETAI_DATABASE_URL                    # domain PostgreSQL as marketai_domain_api
REQUIRED  MARKETAI_TENANT_CONTEXT_SECRET           # >=32 byte HMAC for RLS tenant context

# ── delegated identity verification ──────────────────────────────────
REQUIRED  DELEGATED_JWKS_URL                       # Web's /.well-known/jwks.json (private URL)
OPTIONAL  DELEGATED_JWKS_MAX_STALE_SECONDS
OPTIONAL  DELEGATED_JWKS_REFRESH_INTERVAL_SECONDS
OPTIONAL  DELEGATED_JWKS_INITIAL_LOAD_ATTEMPTS      # startup retry budget; default 20
OPTIONAL  DELEGATED_JWKS_INITIAL_LOAD_BACKOFF_SECONDS  # default 2, doubling
OPTIONAL  DELEGATED_JWKS_INITIAL_LOAD_MAX_BACKOFF_SECONDS  # default 20
OPTIONAL  DELEGATED_JWT_ISSUER
OPTIONAL  DELEGATED_JWT_AUDIENCE

# ── entitlement inbox ────────────────────────────────────────────────
REQUIRED  CONTROL_PLANE_TO_DOMAIN_ENTITLEMENT_TOKEN  # verifies entitlement pushes from Web
REQUIRED  ENTITLEMENT_VERIFICATION_KEY_RING          # `<key id>:<hex of the UTF-8 bytes of Web's ENTITLEMENT_SNAPSHOT_SIGNING_KEY>`, comma-separated; must include Web's signing key ID

# ── object storage ───────────────────────────────────────────────────
REQUIRED  MARKETAI_BLOB_STORE_ADAPTER              # "railway_bucket" for production
REQUIRED  MARKETAI_BLOB_STORE_S3_BUCKET            # Railway Bucket name
REQUIRED  MARKETAI_BLOB_STORE_S3_REGION
REQUIRED  MARKETAI_BLOB_STORE_S3_ENDPOINT_URL      # authenticated public HTTPS endpoint
OPTIONAL  MARKETAI_BLOB_STORE_S3_ADDRESSING_STYLE  # virtual for new buckets; path for legacy
REQUIRED  AWS_ACCESS_KEY_ID                         # Railway Bucket-scoped credential
REQUIRED  AWS_SECRET_ACCESS_KEY                     # Railway Bucket-scoped credential

# ── platform operator ───────────────────────────────────────────────
OPTIONAL  PLATFORM_OPERATOR_JWKS_URL
OPTIONAL  PLATFORM_ADMIN_TOKEN
REQUIRED  MARKETAI_CONTROL_PLANE_INTERNAL_BASE_URL # Railway private URL for Web (projection sync)
REQUIRED  MARKETAI_PROJECTION_SYNC_SERVICE_TOKEN   # matches Web's PROJECTION_SYNC_SERVICE_TOKEN
REQUIRED  DOMAIN_TO_CONTROL_PLANE_SYNC_TOKEN       # matches Web's domain sync token

# ── cost guardrails ──────────────────────────────────────────────────
OPTIONAL  MAX_COST_PER_RUN                         # defaults to 5
OPTIONAL  MAX_COST_PER_DAY                         # defaults to 20
OPTIONAL  MARKETAI_PLATFORM_MAX_PER_OPERATION
OPTIONAL  MARKETAI_PLATFORM_MAX_ROLLING_24H
OPTIONAL  MARKETAI_PLATFORM_MAX_PERIOD
OPTIONAL  MARKETAI_PLATFORM_MAX_OUTSTANDING

# ── Meta read (sandbox + controlled mock) ────────────────────────────
OPTIONAL  META_API_VERSION
OPTIONAL  META_AD_ACCOUNT_ID
OPTIONAL  META_CREDENTIAL_WORKSPACE_ID
OPTIONAL  META_TIMEZONE
OPTIONAL  META_SYNC_ENABLED                        # false in Beta

# ── Meta write (disabled) ────────────────────────────────────────────
OPTIONAL  META_WRITE_ENABLED                       # must be "false"
OPTIONAL  LAUNCH_CONFIRMATION_SECRET

# ── credential KMS ───────────────────────────────────────────────────
OPTIONAL  MARKETAI_CREDENTIAL_KMS_ADAPTER
OPTIONAL  MARKETAI_CREDENTIAL_LOCAL_KMS_SECRET

# ── Railway ──────────────────────────────────────────────────────────
OPTIONAL  PORT                                     # Railway injects this; default 8000
OPTIONAL  RAILWAY_ENVIRONMENT

# ── DENIED: control-plane database ───────────────────────────────────
DENIED    DATABASE_URL                             # control-plane DB belongs to Web only
DENIED    NEXTAUTH_SECRET                          # session key; Web only
DENIED    NEXTAUTH_URL

# ── DENIED: delegated signing key ────────────────────────────────────
DENIED    DELEGATED_SIGNING_PRIVATE_KEY             # API verifies, never signs
DENIED    DELEGATED_SIGNING_KEY_ID
DENIED    DELEGATED_SIGNING_KEY_ENCRYPTION_KEY      # Web-only key decrypts DB-backed signer

# ── DENIED: schema owner credentials ─────────────────────────────────
DENIED    DOMAIN_OWNER_PASSWORD                    # Release only
DENIED    CONTROL_OWNER_PASSWORD
DENIED    CONTROL_APP_PASSWORD

# ── DENIED: Meta write token ─────────────────────────────────────────
DENIED    META_WRITE_ACCESS_TOKEN                  # must remain empty; enforced at deployment

# ── DENIED: object storage root ──────────────────────────────────────
DENIED    MARKETAI_BLOB_STORE_S3_ACCESS_KEY_ID     # Railway Bucket uses attached credentials
DENIED    MARKETAI_BLOB_STORE_S3_SECRET_ACCESS_KEY
