# MarketAI Web (control plane) — environment variable contract.
#
# This file documents which variables the Web service MUST, MAY, and
# MUST NOT receive. It is consumed by the static deployment validator.
#
# Syntax:  REQUIRED | OPTIONAL | DENIED  VARIABLE_NAME  # rationale
#
# REQUIRED — the service fails to start or operate correctly without it.
# OPTIONAL — used when present; sensible default or disabled when absent.
# DENIED   — must never be injected; violates a trust boundary.

# ── identity & session ───────────────────────────────────────────────
REQUIRED  DATABASE_URL                            # control-plane PostgreSQL as marketai_control_app
REQUIRED  NEXTAUTH_URL                            # canonical app URL for NextAuth callbacks
REQUIRED  NEXTAUTH_SECRET                         # session encryption key
REQUIRED  APP_URL                                 # public-facing origin
REQUIRED  MFA_ENCRYPTION_KEY                      # base64 32-byte AES-256 key protecting TOTP seeds at rest (openssl rand -base64 32); Owner MFA enrollment -- the Workspace activation gate -- fails with "MFA encryption is not configured" without it

# ── delegated identity signing ───────────────────────────────────────
REQUIRED  DELEGATED_SIGNING_KEY_ENCRYPTION_KEY     # base64 key encrypting DB-backed ES256 signing material

# ── entitlement sync ─────────────────────────────────────────────────
REQUIRED  CONTROL_PLANE_TO_DOMAIN_ENTITLEMENT_TOKEN  # bearer token for pushing entitlements to API
REQUIRED  ENTITLEMENT_SNAPSHOT_SIGNING_KEY           # HMAC key for signed entitlement envelopes
REQUIRED  ENTITLEMENT_SNAPSHOT_SIGNING_KEY_ID        # key id in the signed envelope
REQUIRED  PROJECTION_SYNC_SERVICE_TOKEN              # authenticates domain authorization-snapshot pulls
REQUIRED  DOMAIN_TO_CONTROL_PLANE_SYNC_TOKEN         # authenticates typed domain onboarding facts

# ── domain API private URL ───────────────────────────────────────────
REQUIRED  DOMAIN_API_BASE_URL                       # Railway private URL for API service

# ── browser blob transfers ───────────────────────────────────────────
REQUIRED  NEXT_PUBLIC_MARKETAI_STORAGE_ORIGINS       # exact https origin of the Bucket as it appears in signed URLs (https://<BUCKET>.t3.storageapi.dev); CSP connect-src + StorageOriginPolicy; inlined at build (Dockerfile ARG), so set it before building

# ── email ────────────────────────────────────────────────────────────
OPTIONAL  SMTP_HOST                                # SMTP relay; invitations print URLs when absent
OPTIONAL  SMTP_PORT
OPTIONAL  SMTP_USER
OPTIONAL  SMTP_PASSWORD
OPTIONAL  SMTP_FROM

# ── Railway ──────────────────────────────────────────────────────────
OPTIONAL  PORT                                     # Railway injects this; default 4002
OPTIONAL  RAILWAY_ENVIRONMENT                      # staging | production

# ── DENIED: domain database ─────────────────────────────────────────
DENIED    MARKETAI_DATABASE_URL                    # domain DB belongs to API/Worker only
DENIED    MARKETAI_TENANT_CONTEXT_SECRET           # domain tenant HMAC; Web has no domain DB access

# ── DENIED: domain role passwords ────────────────────────────────────
DENIED    DOMAIN_OWNER_PASSWORD                    # schema owner credential; Release only
DENIED    DOMAIN_API_PASSWORD                      # API runtime credential
DENIED    DOMAIN_WORKER_PASSWORD                   # Worker runtime credential
DENIED    DOMAIN_READONLY_PASSWORD
DENIED    DOMAIN_APP_PASSWORD
DENIED    CONTROL_OWNER_PASSWORD                   # control schema owner; Release only

# ── DENIED: AI provider keys ────────────────────────────────────────
DENIED    GEMINI_API_KEY                           # BYOK credentials live in domain only
DENIED    OPENAI_API_KEY
DENIED    ARK_API_KEY

# ── DENIED: Meta credentials ────────────────────────────────────────
DENIED    META_ACCESS_TOKEN                        # domain-side Meta read credentials
DENIED    META_APP_SECRET
DENIED    META_WRITE_ACCESS_TOKEN                  # must remain empty globally; enforced here too

# ── DENIED: object storage root ──────────────────────────────────────
DENIED    MARKETAI_BLOB_STORE_S3_ACCESS_KEY_ID     # runtime services use signed URLs, not root creds
DENIED    MARKETAI_BLOB_STORE_S3_SECRET_ACCESS_KEY
DENIED    AWS_ACCESS_KEY_ID                        # Web receives presigned capabilities only
DENIED    AWS_SECRET_ACCESS_KEY
