# Add these references to the run-to-completion Release service alongside its
# existing database-owner variables.  The credentials are used only by the
# read/write/delete connectivity probe and are never printed.
MARKETAI_BLOB_STORE_ADAPTER=railway_bucket
MARKETAI_BLOB_STORE_S3_BUCKET=${{Bucket.BUCKET}}
MARKETAI_BLOB_STORE_S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
MARKETAI_BLOB_STORE_S3_REGION=${{Bucket.REGION}}
MARKETAI_BLOB_STORE_S3_ADDRESSING_STYLE=virtual
AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# Exact https origin(s) the browser transfers blobs from -- the Web APP_URL.
# The Release writes the matching bucket CORS rule (GET/HEAD/PUT) on every
# run; rename `Web` to the Web service's canvas name.
MARKETAI_BLOB_STORE_BROWSER_ORIGINS=${{Web.APP_URL}}
