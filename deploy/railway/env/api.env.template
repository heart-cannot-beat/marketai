# Paste into the API service's Railway Variables raw editor.
# Rename the `Bucket` service reference if the Railway Bucket has another
# display name.  Values stay as Railway references; never commit resolutions.
MARKETAI_BLOB_STORE_ADAPTER=railway_bucket
MARKETAI_BLOB_STORE_S3_BUCKET=${{Bucket.BUCKET}}
MARKETAI_BLOB_STORE_S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
MARKETAI_BLOB_STORE_S3_REGION=${{Bucket.REGION}}
MARKETAI_BLOB_STORE_S3_ADDRESSING_STYLE=virtual
AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
