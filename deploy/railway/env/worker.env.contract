# MarketAI Worker (domain background processor) — environment variable contract.
#
# Private service, no HTTP port, no public endpoint. Polls the durable
# job queue and executes domain tasks with external side effects.
#
# Syntax:  REQUIRED | OPTIONAL | DENIED  VARIABLE_NAME  # rationale

# ── domain database ──────────────────────────────────────────────────
REQUIRED  MARKETAI_DATABASE_URL                    # domain PostgreSQL as marketai_domain_worker
REQUIRED  MARKETAI_TENANT_CONTEXT_SECRET           # >=32 byte HMAC for RLS tenant context

# ── object storage ───────────────────────────────────────────────────
REQUIRED  MARKETAI_BLOB_STORE_ADAPTER              # "railway_bucket" for production
REQUIRED  MARKETAI_BLOB_STORE_S3_BUCKET            # Railway Bucket name
REQUIRED  MARKETAI_BLOB_STORE_S3_REGION
REQUIRED  MARKETAI_BLOB_STORE_S3_ENDPOINT_URL      # authenticated public HTTPS endpoint
OPTIONAL  MARKETAI_BLOB_STORE_S3_ADDRESSING_STYLE
REQUIRED  AWS_ACCESS_KEY_ID                         # Railway Bucket-scoped credential
REQUIRED  AWS_SECRET_ACCESS_KEY                     # Railway Bucket-scoped credential

# ── job queue tuning ─────────────────────────────────────────────────
OPTIONAL  JOB_LEASE_SECONDS                        # default 300
OPTIONAL  JOB_POLL_SECONDS                         # default 0.5
OPTIONAL  WORKER_DRAIN_TIMEOUT_SECONDS             # must be >= JOB_LEASE_SECONDS

# ── control-plane onboarding facts ───────────────────────────────────
REQUIRED  MARKETAI_CONTROL_PLANE_INTERNAL_BASE_URL # Railway private URL for Web; same value as API's
REQUIRED  DOMAIN_TO_CONTROL_PLANE_SYNC_TOKEN       # must equal Web's DOMAIN_TO_CONTROL_PLANE_SYNC_TOKEN
OPTIONAL  MARKETAI_PROJECTION_SYNC_TIMEOUT_MS      # per-delivery HTTP timeout; default 3000

# ── cost guardrails ──────────────────────────────────────────────────
OPTIONAL  MAX_COST_PER_RUN
OPTIONAL  MAX_COST_PER_DAY
OPTIONAL  MARKETAI_PLATFORM_MAX_PER_OPERATION
OPTIONAL  MARKETAI_PLATFORM_MAX_ROLLING_24H
OPTIONAL  MARKETAI_PLATFORM_MAX_PERIOD
OPTIONAL  MARKETAI_PLATFORM_MAX_OUTSTANDING

# ── Meta read credentials (for sync jobs) ────────────────────────────
OPTIONAL  META_ACCESS_TOKEN                        # customer BYOK, injected per workspace
OPTIONAL  META_APP_SECRET
OPTIONAL  META_API_VERSION
OPTIONAL  META_AD_ACCOUNT_ID
OPTIONAL  META_CREDENTIAL_WORKSPACE_ID
OPTIONAL  META_TIMEZONE
OPTIONAL  META_SYNC_ENABLED
OPTIONAL  META_SYNC_HOUR
OPTIONAL  META_LOOKBACK_DAYS
OPTIONAL  META_HTTP_TIMEOUT
OPTIONAL  META_PAGE_LIMIT
OPTIONAL  META_PURCHASE_ACTION_TYPE
OPTIONAL  META_FRESHNESS_SLO_HOURS

# ── Meta write (disabled) ────────────────────────────────────────────
OPTIONAL  META_WRITE_ENABLED                       # must be "false"
OPTIONAL  LAUNCH_CONFIRMATION_SECRET
OPTIONAL  LAUNCH_MAX_DAILY_BUDGET_MINOR

# ── credential KMS ───────────────────────────────────────────────────
OPTIONAL  MARKETAI_CREDENTIAL_KMS_ADAPTER
OPTIONAL  MARKETAI_CREDENTIAL_LOCAL_KMS_SECRET

# ── library content safety ───────────────────────────────────────────
OPTIONAL  LIBRARY_CONTENT_SAFETY_MODE              # default "mock"

# ── Railway ──────────────────────────────────────────────────────────
OPTIONAL  RAILWAY_ENVIRONMENT

# ── DENIED: control-plane database ───────────────────────────────────
DENIED    DATABASE_URL
DENIED    NEXTAUTH_SECRET
DENIED    NEXTAUTH_URL

# ── DENIED: delegated identity (Worker has no HTTP surface) ──────────
DENIED    DELEGATED_JWKS_URL
DENIED    DELEGATED_SIGNING_PRIVATE_KEY
DENIED    DELEGATED_SIGNING_KEY_ID
DENIED    DELEGATED_SIGNING_KEY_ENCRYPTION_KEY

# ── DENIED: schema owner credentials ─────────────────────────────────
DENIED    DOMAIN_OWNER_PASSWORD
DENIED    CONTROL_OWNER_PASSWORD
DENIED    CONTROL_APP_PASSWORD

# ── DENIED: Meta write token ─────────────────────────────────────────
DENIED    META_WRITE_ACCESS_TOKEN                  # must remain empty; enforced at deployment

# ── DENIED: object storage root ──────────────────────────────────────
DENIED    MARKETAI_BLOB_STORE_S3_ACCESS_KEY_ID
DENIED    MARKETAI_BLOB_STORE_S3_SECRET_ACCESS_KEY
