# MarketAI entitlement dispatcher — private Railway cron service.
# Uses Dockerfile.web with start command `npm run ops:dispatch-entitlements`.
# A run must exit; schedule `*/5 * * * *` (Railway's minimum interval).

REQUIRED  DATABASE_URL                            # control-plane app role, same database as Web
REQUIRED  DOMAIN_API_BASE_URL                    # private FastAPI origin
REQUIRED  CONTROL_PLANE_TO_DOMAIN_ENTITLEMENT_TOKEN # entitlement inbox bearer token
REQUIRED  ENTITLEMENT_SNAPSHOT_SIGNING_KEY       # signs lease renewals and reconciliation snapshots
REQUIRED  ENTITLEMENT_SNAPSHOT_SIGNING_KEY_ID    # must be in API verification key ring
OPTIONAL  ENTITLEMENT_DISPATCH_BATCH_SIZE        # default 50
OPTIONAL  ENTITLEMENT_RENEWAL_INTERVAL_SECONDS   # lease renewal cadence, default 21600 (6h); max 72000
OPTIONAL  ENTITLEMENT_DISPATCHER_ID              # defaults to hostname and process ID
OPTIONAL  RAILWAY_ENVIRONMENT

DENIED    MARKETAI_DATABASE_URL                  # no direct domain DB access
DENIED    MARKETAI_TENANT_CONTEXT_SECRET
DENIED    NEXTAUTH_SECRET                       # no interactive sessions
DENIED    DELEGATED_SIGNING_PRIVATE_KEY
DENIED    DELEGATED_SIGNING_KEY_ENCRYPTION_KEY
DENIED    DOMAIN_OWNER_PASSWORD
DENIED    CONTROL_OWNER_PASSWORD
DENIED    AWS_ACCESS_KEY_ID
DENIED    AWS_SECRET_ACCESS_KEY
DENIED    META_WRITE_ACCESS_TOKEN
