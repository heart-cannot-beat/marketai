# Paste into the Worker service's Railway Variables raw editor.
# The Worker needs bucket credentials for verification, commit, generated
# artifacts, and durable staging cleanup.  It receives no schema-owner role.
MARKETAI_BLOB_STORE_ADAPTER=railway_bucket
MARKETAI_BLOB_STORE_S3_BUCKET=${{Bucket.BUCKET}}
MARKETAI_BLOB_STORE_S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
MARKETAI_BLOB_STORE_S3_REGION=${{Bucket.REGION}}
MARKETAI_BLOB_STORE_S3_ADDRESSING_STYLE=virtual
AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# The Worker alone delivers onboarding facts to the Web.  Reference both so the
# base URL follows the API's and the token stays equal to the Web's.
MARKETAI_CONTROL_PLANE_INTERNAL_BASE_URL=${{marketai-api.MARKETAI_CONTROL_PLANE_INTERNAL_BASE_URL}}
DOMAIN_TO_CONTROL_PLANE_SYNC_TOKEN=${{marketai-web.DOMAIN_TO_CONTROL_PLANE_SYNC_TOKEN}}
