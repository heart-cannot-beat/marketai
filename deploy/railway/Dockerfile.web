# Railway production Dockerfile for the control-plane Web service.
#
# The only service with a public HTTPS endpoint. Serves the SaaS UI
# and BFF; all domain API calls go over Railway private networking.

FROM node:22-bookworm-slim AS dependencies

WORKDIR /srv/marketai/web
COPY web/package.json web/package-lock.json ./
RUN npm ci

# ── build ────────────────────────────────────────────────────────────
FROM dependencies AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

COPY web/ ./

# `NEXT_PUBLIC_*` values are inlined into the client bundle by `next build`,
# so the browser's storage-origin allowlist (`StorageOriginPolicy`) must be
# known here, not only at runtime.  Railway passes service variables to the
# build as build arguments, but a Dockerfile only sees the ones it declares.
ARG NEXT_PUBLIC_MARKETAI_STORAGE_ORIGINS=""
ENV NEXT_PUBLIC_MARKETAI_STORAGE_ORIGINS=${NEXT_PUBLIC_MARKETAI_STORAGE_ORIGINS}

# Prisma generate must run before next build.
RUN npx prisma generate \
    && npm run build \
    && npm run build:ops

# ── production dependencies ──────────────────────────────────────────
FROM dependencies AS production-deps

RUN npm prune --omit=dev \
    && npm cache clean --force

# ── runtime ──────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl curl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PORT=4002

WORKDIR /srv/marketai/web

COPY web/package.json web/package-lock.json ./
COPY --from=production-deps /srv/marketai/web/node_modules ./node_modules
# `prisma generate` runs only in the build stage.  The generated query
# engine/client metadata lives outside the @prisma/client package, so copy it
# into the runtime image alongside the pruned production dependencies.
COPY --from=build /srv/marketai/web/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /srv/marketai/web/.next ./.next
COPY --from=build /srv/marketai/web/.ops ./.ops
COPY web/next.config.js web/next-i18next.config.js web/postcss.config.js web/tailwind.config.js ./
COPY web/locales ./locales
COPY web/public ./public
COPY web/prisma ./prisma

RUN chown -R node:node /srv/marketai/web
USER node

EXPOSE 4002

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:4002/api/readiness || exit 1

CMD ["npm", "start"]
