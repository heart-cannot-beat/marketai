FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .

# Build-time only — overridden at runtime by docker-compose environment.
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV APP_URL=http://localhost:4002
ENV NEXTAUTH_URL=http://localhost:4002
ENV NEXTAUTH_SECRET=build-time-only-not-for-production

ARG NEXT_PUBLIC_MARKETAI_STORAGE_ORIGINS=""
ARG NEXT_PUBLIC_MARKETAI_ALLOW_INSECURE_LOOPBACK_STORAGE="false"
ENV NEXT_PUBLIC_MARKETAI_STORAGE_ORIGINS=${NEXT_PUBLIC_MARKETAI_STORAGE_ORIGINS}
ENV NEXT_PUBLIC_MARKETAI_ALLOW_INSECURE_LOOPBACK_STORAGE=${NEXT_PUBLIC_MARKETAI_ALLOW_INSECURE_LOOPBACK_STORAGE}

RUN npx prisma generate
RUN npm run build

ENV PORT=4002
EXPOSE 4002
CMD ["npm", "start"]
