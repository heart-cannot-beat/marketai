{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "outDir": "../.ts-node-out"
  },
  "include": ["**/*.ts"],
  "ts-node": {
    "transpileOnly": true
  }
}
