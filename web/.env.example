# ===================== MarketAI control plane (web) =====================
# Copy to web/.env and fill in. This service owns identity, Workspace
# membership, invitations and account administration only. It never receives
# MarketAI domain database credentials; it reaches FastAPI over HTTP.

# ---- Application ----
APP_URL=http://localhost:4002
NEXTAUTH_URL=http://localhost:4002

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Must stay `jwt`. next-auth refuses a credentials sign-in when the strategy is
# `database` and every provider is `credentials`, which is this fork's provider
# set. The JWT is only a carrier: it is bound to a server-side session row by
# its `sid` claim, and every request re-reads that row, so sign-out, a password
# change and a password reset revoke it immediately.
NEXTAUTH_SESSION_STRATEGY=jwt

# ---- Control-plane database (runtime identity only) ----
# The runtime role: SELECT/INSERT/UPDATE/DELETE, no DDL. This file becomes the
# running process's environment, so the schema-owner credential deliberately
# does not appear here — see .env.migrate.example.
DATABASE_URL=postgresql://marketai_control_app:CHANGE_ME@localhost:5432/marketai_control

# ---- Transactional email (invitations, password reset, verification) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Require email confirmation before the account can be used
CONFIRM_EMAIL=false

# Only accept work email addresses
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

# ---- Security ----
# Security headers and CSP are ON by default. Setting this to `false` is a
# development-only escape hatch and is asserted against in CI.
SECURITY_HEADERS_ENABLED=true

# Account lockout
MAX_LOGIN_ATTEMPTS=5

# Fixed-window rate limiting for authentication and mutation routes
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MUTATION_MAX=60

# ---- Domain service (BFF -> FastAPI, spec §4.8, §6.7) ----
# Origin of the private FastAPI domain API. Also used by the readiness probe.
DOMAIN_API_BASE_URL=http://localhost:8000

# undici Pool / per-attempt timeout tuning for the BFF catch-all proxy.
DOMAIN_API_MAX_CONNECTIONS=20
DOMAIN_API_HEADERS_TIMEOUT_MS=10000
DOMAIN_API_BODY_TIMEOUT_MS=30000
DOMAIN_API_MAX_RETRIES=1

# Absolute deadline (ms) for the whole BFF proxy request lifecycle: session,
# CSRF, body read, token mint, proxy, response validation.
TOTAL_DEADLINE_MS=55000

# ---- Delegated identity (BFF-issued ES256 JWTs, spec §1.7, §2.2) ----
# 32-byte AES-256 key (base64) protecting DelegatedSigningKey private keys at
# rest. Generate with: openssl rand -base64 32
DELEGATED_SIGNING_KEY_ENCRYPTION_KEY=

# Independent 32-byte AES-256 key (base64) protecting TOTP seeds at rest.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Short-lived ES256 support-operator assertions used by audited ops scripts.
# Tokens are issued upstream. This process receives only the issuer's public
# JWKS (inline JSON); never deploy the issuer private key here.
OPERATOR_IDENTITY_JWKS=
OPERATOR_IDENTITY_TOKEN=

# HMAC key and identifier for signed entitlement snapshots created during
# Workspace provisioning/reconciliation.
ENTITLEMENT_SNAPSHOT_SIGNING_KEY=
ENTITLEMENT_SNAPSHOT_SIGNING_KEY_ID=beta-v1

# max-age for the JWKS Cache-Control header; also feeds the verify_until
# calculation for a retiring key.
SIGNER_CACHE_MAX_AGE=600

# Maximum exp - iat for a delegated JWT.
DELEGATED_TOKEN_MAX_TTL_SECONDS=60

# Bearer token FastAPI's projection sync presents to
# /api/internal/domain/workspaces/{workspaceId}/authorization-snapshot. Empty
# by default -- that endpoint refuses every request until this is set.
PROJECTION_SYNC_SERVICE_TOKEN=

# Bearer token presented by the domain outbox dispatcher when it pushes typed
# onboarding facts to /api/internal/domain/onboarding.
DOMAIN_TO_CONTROL_PLANE_SYNC_TOKEN=

# ---- Observability (optional) ----
OTEL_PREFIX=marketai.control_plane
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=

# ---- UI ----
NEXT_PUBLIC_DARK_MODE=false
NEXT_PUBLIC_TERMS_URL=/terms
NEXT_PUBLIC_PRIVACY_URL=/privacy
NEXT_PUBLIC_SUPPORT_URL=

# ---- Database-role isolation tests (CI / local PostgreSQL only) ----
# Deliberately crossed connection strings. Both must fail to connect.
# CONTROL_PLANE_DATABASE_URL=postgresql://marketai_control_app:...@localhost:5432/marketai_control
# CONTROL_ROLE_ON_DOMAIN_DB_URL=postgresql://marketai_control_app:...@localhost:5432/marketai_domain
# DOMAIN_ROLE_ON_CONTROL_DB_URL=postgresql://marketai_domain_app:...@localhost:5432/marketai_control

# ===================== Removed upstream configuration =====================
# The following upstream keys have no effect because the capability is not
# present in this fork: SVIX_*, JACKSON_*, RETRACED_*, STRIPE_*, SENTRY_*,
# RECAPTCHA_*, SLACK_WEBHOOK_URL, NEXT_PUBLIC_MIXPANEL_TOKEN, GITHUB_CLIENT_*,
# GOOGLE_CLIENT_*, AUTH_PROVIDERS, FEATURE_TEAM_*, HIDE_LANDING_PAGE,
# GROUP_PREFIX. See web/HARDENING.md.
