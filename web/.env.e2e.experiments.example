# Copy to .env.e2e.experiments before running `npm run test:e2e:experiments`.
# After `npx playwright test --project identities` (e2e/README.md) the owner,
# member and Workspace values come from e2e/.auth/identities.env and can be
# left out here. That Workspace is not the one Localization and Scale use:
# each Experiments seed retires the Workspace's earlier Meta connections.
E2E_BASE_URL=http://localhost:4002
# Required destructive-test acknowledgement. The seeds still reject any
# database host outside localhost/loopback or the compose `postgres` service.
E2E_EXPERIMENTS_ALLOW_MUTATIONS=1
# Exact isolated Docker Compose project whose API and Worker Launch recovery
# stops, starts and restarts (`docker compose -p <project> ...`).
E2E_EXPERIMENTS_COMPOSE_PROJECT=marketai-experiments-e2e
E2E_OWNER_EMAIL=owner@example.test
E2E_OWNER_PASSWORD=replace-me
E2E_MEMBER_EMAIL=member@example.test
E2E_MEMBER_PASSWORD=replace-me
# A Workspace both the Owner and the Member belong to.
E2E_EXPERIMENTS_WORKSPACE_ID=00000000-0000-4000-8000-000000000000
E2E_EXPERIMENTS_WORKSPACE_SLUG=workspace-a
E2E_OWNER_USER_ID=00000000-0000-4000-8000-000000000001
# Must equal the domain Workspace projection's current authorization_epoch.
E2E_EXPERIMENTS_AUTHORIZATION_EPOCH=0
# An existing Workspace the Owner does not belong to (Scenario 6's
# cross-Workspace checks). Defaults to workspace-b.
E2E_EXPERIMENTS_FOREIGN_WORKSPACE_SLUG=workspace-b
E2E_PYTHON=python3
MARKETAI_DATABASE_URL=postgresql+psycopg://marketai_domain_owner:replace-me@localhost:5432/marketai_domain
MARKETAI_TENANT_CONTEXT_SECRET=replace-with-the-stack-tenant-context-secret
