# Copy to .env.e2e.localization before running `npm run test:e2e:localization`.
# Keep the workspace UUID and owner user UUID aligned with the same isolated
# stack; the seed helper verifies the workspace authorization epoch. After
# `npx playwright test --project identities` (e2e/README.md) the owner, member
# and Workspace values come from e2e/.auth/identities.env instead.
E2E_BASE_URL=http://localhost:4002
# Required destructive-test acknowledgement. The seed still rejects any
# database host outside localhost/loopback or the compose `postgres` service.
E2E_LOCALIZATION_ALLOW_MUTATIONS=1
# Exact isolated Docker Compose project whose Worker the recovery test restarts.
E2E_LOCALIZATION_COMPOSE_PROJECT=marketai-localization-e2e
# Used only by the guarded prerequisite seed to create a real foreign control
# Workspace. It must target the same local/Compose cluster as the domain DSN.
E2E_LOCALIZATION_CONTROL_OWNER_DATABASE_URL=postgresql+psycopg://marketai_control_owner:replace-me@localhost:5432/marketai_control
E2E_OWNER_EMAIL=owner@example.test
E2E_OWNER_PASSWORD=replace-me
E2E_MEMBER_EMAIL=member@example.test
E2E_MEMBER_PASSWORD=replace-me
E2E_LOCALIZATION_WORKSPACE_ID=00000000-0000-4000-8000-000000000000
E2E_OWNER_USER_ID=00000000-0000-4000-8000-000000000001
E2E_LOCALIZATION_WORKSPACE_SLUG=workspace-a
E2E_LOCALIZATION_AUTHORIZATION_EPOCH=0
E2E_PYTHON=python3
MARKETAI_DATABASE_URL=postgresql+psycopg://marketai_domain_owner:replace-me@localhost:5432/marketai_domain
MARKETAI_TENANT_CONTEXT_SECRET=replace-with-the-stack-tenant-context-secret
