{
  "name": "marketai-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "MarketAI SaaS control plane. Hardened fork of BoxyHQ SaaS Starter Kit; see UPSTREAM.json and HARDENING.md.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --port 4002",
    "build": "prisma generate && next build && npm run build:ops",
    "check-static-csp": "node scripts/check-static-csp.mjs",
    "start": "next start --port 4002",
    "db:generate": "prisma generate",
    "db:migrate:dev": "node scripts/prisma-migrate.mjs dev",
    "db:migrate:deploy": "node scripts/prisma-migrate.mjs deploy",
    "db:migrate:status": "node scripts/prisma-migrate.mjs status",
    "ops:provision-workspace": "node .ops/scripts/provision-workspace.js",
    "ops:dispatch-entitlements": "node .ops/scripts/dispatch-entitlements.js",
    "ops:reconcile-workspace-provisioning": "node .ops/scripts/reconcile-workspace-provisioning.js",
    "ops:bootstrap-delegated-signing-key": "node .ops/scripts/bootstrap-delegated-signing-key.js",
    "ops:prune-sessions": "node .ops/scripts/prune-sessions.js",
    "ops:mfa-reset": "node .ops/scripts/mfa-reset.js",
    "ops:reissue-first-owner": "node .ops/scripts/reissue-first-owner.js",
    "check-types": "tsc --pretty --noEmit",
    "check-types:e2e": "tsc --pretty --noEmit --project e2e/tsconfig.json",
    "check-format": "prettier --check .",
    "check-lint": "eslint -c eslint.config.cjs ./",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:db-isolation": "jest --testPathPatterns=__tests__/integration --runInBand",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:localization": "node scripts/run-localization-e2e.mjs",
    "i18n:missing": "node scripts/i18n-missing.mjs",
    "inventory:licenses": "node scripts/license-inventory.mjs",
    "inventory:licenses:check": "node scripts/license-inventory.mjs --check",
    "verify": "npm run check-format && npm run check-lint && npm run check-types && npm run check-types:e2e && npm run test && npm run build && npm run check-static-csp && npm run check-ops",
    "build:ops": "tsc --project scripts/tsconfig.build.json",
    "check-ops": "node scripts/check-ops.mjs",
    "test:image-editor": "node scripts/check-visual-image-editor.mjs"
  },
  "dependencies": {
    "@boxyhq/metrics": "0.2.15",
    "@heroicons/react": "2.2.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@next/env": "15.5.14",
    "@prisma/client": "6.10.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.8",
    "@tailwindcss/typography": "0.5.19",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "bcryptjs": "3.0.3",
    "classnames": "2.5.1",
    "cookies-next": "6.1.1",
    "formik": "2.4.9",
    "i18next": "25.10.9",
    "micromatch": "4.0.8",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "next-i18next": "15.4.3",
    "nodemailer": "7.0.11",
    "react": "18.3.1",
    "react-daisyui": "5.0.5",
    "react-dom": "18.3.1",
    "react-email": "6.1.1",
    "react-hot-toast": "2.6.0",
    "react-i18next": "15.5.3",
    "sharp": "0.34.5",
    "swr": "2.4.1",
    "undici": "^8.10.0",
    "yup": "1.7.1",
    "zod": "3.25.64"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "30.0.0",
    "@types/micromatch": "4.0.10",
    "@types/node": "25.6.2",
    "@types/nodemailer": "7.0.4",
    "@types/react": "18.3.13",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "autoprefixer": "10.4.27",
    "daisyui": "4.12.24",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.14",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.4",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "node-mocks-http": "1.17.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "prisma": "6.10.0",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react-email": {
      "esbuild": ">=0.25.0",
      "next": ">=15.2.3"
    },
    "@react-email/components": {
      "prismjs": ">=1.30.0"
    }
  }
}
