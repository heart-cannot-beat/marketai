# ======= MarketAI Studio 环境配置 =======
# 复制本文件为 .env 并填入你的 key（不需要全部填，填了哪个哪个可用）

# Google Gemini / Nano Banana（图片生成 + 角度引擎 LLM）
# 获取: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI GPT-Image（图片生成，可选作 LLM）
# 获取: https://platform.openai.com/api-keys （GPT-Image 需要组织验证）
OPENAI_API_KEY=

# 火山引擎方舟 Ark / 即梦 Seedream
# 获取: https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=

# ---- 可选：模型与端点覆盖（默认值一般不用改） ----
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image      # 或 gemini-3-pro-image / gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1.5               # 或 gpt-image-1 / gpt-image-1-mini / gpt-image-2
# SEEDREAM_MODEL=doubao-seedream-4-5-251128      # 或 doubao-seedream-4-0-250828
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_BASE_URL=https://api.openai.com/v1
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- 角度引擎用哪个 LLM：gemini / openai（默认自动选有 key 的那个）----
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# ---- 生成并发（每个 provider 同时几张）----
# GEN_CONCURRENCY=2

# ---- 领域数据库 ----
# 本地/导入兼容路径默认 sqlite:///项目目录/data/marketai.db。
# 托管 PostgreSQL 必须给 API 与 Worker 分别注入同名变量、不同角色的 URL：
# API:    postgresql+psycopg://marketai_domain_api:...@host/marketai_domain
# Worker: postgresql+psycopg://marketai_domain_worker:...@host/marketai_domain
# MARKETAI_DATABASE_URL=sqlite:////absolute/path/to/data/marketai.db
# Hosted API/Worker and `make db-release` must share this 32+ byte HMAC secret.
# MARKETAI_TENANT_CONTEXT_SECRET=replace-with-a-secret-manager-value
# SQLite local launcher identity (run.py enables these explicitly).
# MARKETAI_LOCAL_IDENTITY_ENABLED=false
# MARKETAI_LOCAL_WORKSPACE_ID=ws_local
# MARKETAI_LOCAL_INITIATOR_ID=local-owner
# MARKETAI_WORKSPACE_ID=ws_default
# MARKETAI_CURRENCY=USD
# SQLITE_BUSY_TIMEOUT_MS=5000
# JOB_LEASE_SECONDS=300
# JOB_POLL_SECONDS=0.5

# ---- BlobStore ----
# Local development keeps the default `local` adapter. Railway services use
# the reference templates under deploy/railway/env/; never paste resolved
# bucket credentials into this file or commit them.
# MARKETAI_BLOB_STORE_ADAPTER=local
# MARKETAI_BLOB_STORE_S3_BUCKET=${{Bucket.BUCKET}}
# MARKETAI_BLOB_STORE_S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
# MARKETAI_BLOB_STORE_S3_REGION=${{Bucket.REGION}}
# MARKETAI_BLOB_STORE_S3_ADDRESSING_STYLE=virtual
# AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}

# 成本硬上限，任何请求参数都不能绕过
# MAX_COST_PER_RUN=5
# MAX_COST_PER_DAY=20

# ---- Meta Marketing API（严格只读；不会创建/修改广告）----
# 必须显式填写；例如先核对当前账户支持版本，再填 v26.0。升级前先跑 fixture/对账
META_API_VERSION=
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# META_AD_ACCOUNT_ID=act_123456789
# META_CREDENTIAL_WORKSPACE_ID=ws_...
# META_TIMEZONE=Asia/Hong_Kong
# META_PURCHASE_ACTION_TYPE=omni_purchase
# META_LOOKBACK_DAYS=3
# META_HTTP_TIMEOUT=45
# META_PAGE_LIMIT=100
# META_SYNC_HOUR=3
# META_FRESHNESS_SLO_HOURS=36
# 凭证和首次手动同步验证通过后再打开每日调度
# META_SYNC_ENABLED=false

# ---- Launch canary 写入（与只读 Token 隔离；默认硬禁用）----
# 必须使用专用测试账户、单独的 ads_management Token，并先完成只读对账
META_WRITE_ACCESS_TOKEN=
# 至少 32 字节随机值；用于签发短时、一次性的 Preview 确认 token
LAUNCH_CONFIRMATION_SECRET=
# 推荐生产/本机改用权限 600 的文件，避免密钥直接出现在 .env
# LAUNCH_CONFIRMATION_SECRET_FILE=data/secrets/launch_confirmation_secret
# Preview 15 分钟、确认 5 分钟
# LAUNCH_PREVIEW_TTL_SECONDS=900
# LAUNCH_CONFIRM_TTL_SECONDS=300
# 账户最小币种单位，例如 USD cents。即使对象始终 PAUSED 也执行硬上限
# LAUNCH_MAX_DAILY_BUDGET_MINOR=500
# 最后才打开；关闭时 Worker 拒绝所有真实 Meta POST
META_WRITE_ENABLED=false

# ---- 创意库参考素材门禁（原件私有，Provider 只读受控派生）----
# 上限是服务端硬门禁，请求参数不能绕过
# LIBRARY_MAX_REFERENCE_BYTES=20971520
# LIBRARY_MAX_REFERENCE_PIXELS=50000000
# LIBRARY_MAX_REFERENCE_SIDE=12000
# 受控派生送往 Provider 前的最长边
# LIBRARY_DERIVATIVE_MAX_SIDE=1024
# 内容安全 adapter：mock=受控 Mock；real 需要先接入真实服务，永不静默回落
# LIBRARY_CONTENT_SAFETY_MODE=mock

# SaaS generation: explicit operator-reviewed maximum USD cost per image,
# keyed by provider/model/resolution. No default payable prices are assumed.
# Include maximum prompt input + output costs; update the pricing version
# whenever this registry changes. Example shape (values are illustrative):
# MARKETAI_GENERATION_MAX_COSTS_JSON={"openai":{"gpt-image-1.5":{"1K":"0.30","2K":"0.50"}}}
# MARKETAI_PRICE_REGISTRY_VERSION=v1

# 竞品扫描的数据供应商（Workspace 自带 ScrapeCreators Key，binding_scope=market_data）。
# 价格表：供应商 → 操作 → 每次调用的额度与额度单价；五种操作缺一则拒绝所有真实报价
# （受控 Mock 不受影响）。改价时同步 MARKETAI_PRICE_REGISTRY_VERSION。以下为 Freelance 档示例。
# MARKETAI_MARKET_DATA_MAX_COSTS_JSON={"scrapecreators":{"page_search":{"credits":1,"credit_usd":"0.00188"},"probe":{"credits":1,"credit_usd":"0.00188"},"page":{"credits":1,"credit_usd":"0.00188"},"keyword_page":{"credits":1,"credit_usd":"0.00188"},"ad_refresh":{"credits":1,"credit_usd":"0.00188"}}}
# 保存 Key 时调用免费的 /v1/account/credit-balance 检查余额；测试与本机验收指向受控桩，不连真实供应商。
# MARKETAI_SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com
# MARKETAI_SCRAPECREATORS_CHECK_TIMEOUT_SECONDS=5
# 相关性判断的规则前置：关键词发现的观察落地到这些批发站，或广告主分类含这些词，直接判为无关、不送 LLM。
# MARKETAI_COMPETITOR_WHOLESALE_DOMAINS=alibaba.com,aliexpress.com,1688.com,made-in-china.com,dhgate.com,globalsources.com,indiamart.com
# MARKETAI_COMPETITOR_DEALER_CATEGORY_TERMS=dealer,经销商,车行
# 起草时选同市场的竞品快照：方案的自由文本 market 按此表规范化为两位国家码，再与扫描的 country 比较；
# 键在匹配前小写、去空白。未配置（默认 {}）时只认两位国家码本身，其余都判为不匹配，方案不引用快照。
# MARKETAI_MARKET_COUNTRY_ALIASES_JSON={"北美":"US","north america":"US","usa":"US","united states":"US","美国":"US","canada":"CA","加拿大":"CA","uk":"GB","united kingdom":"GB","英国":"GB","australia":"AU","澳大利亚":"AU","germany":"DE","德国":"DE","japan":"JP","日本":"JP"}

# 新版 AI 营销策划：仅使用 Workspace BYOK，显式配置模型与每次最大成本。
# 原始产品资料最多 16000 字；每次完整策划输入（含 Schema）最多 96000 UTF-8 bytes，输出最多 8192 token；
# 报价须覆盖请求输入与输出上限。以下金额不是供应商现价。
# 产品理解、方案策划和结果 AI 解读共用本配置；每次单独确认费用。
# OpenAI 请求固定 standard tier / store=false，不跟随账户的 priority 默认。
MARKETAI_PLANNING_PROVIDER=openai
MARKETAI_PLANNING_MODEL=gpt-4.1-mini-2025-04-14
MARKETAI_PLANNING_MAX_COST_USD=0.10

# 新版营销视觉 QC：Workspace BYOK，覆盖目标图与最多两张对照图。
# 模型须明确支持图片输入与结构化 JSON；不配置时不会自动改用全局 Key。
MARKETAI_MARKETING_QC_PROVIDER=openai
MARKETAI_MARKETING_QC_MODEL=gpt-4.1-mini-2025-04-14
MARKETAI_MARKETING_QC_MAX_COST_USD=0.10

# Independent Worker lanes, bounded per process (scale total against provider limits).
# WORKER_GENERATION_CONCURRENCY=2
# WORKER_QC_CONCURRENCY=1
# WORKER_PLANNING_CONCURRENCY=1
# WORKER_GENERAL_CONCURRENCY=1
